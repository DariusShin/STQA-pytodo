<TestAction guiclass="TestActionGui" testclass="TestAction" testname="Think, then choose action" enabled="true">
  <intProp name="ActionProcessor.action">1</intProp>
  <intProp name="ActionProcessor.target">0</intProp>
  <stringProp name="ActionProcessor.duration">0</stringProp>
</TestAction>
<hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Pick next action (weights 4:3:2:2:1)" enabled="true">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">def rnd = java.util.concurrent.ThreadLocalRandom.current()
def r = rnd.nextInt(12)
vars.put('action', r &lt; 4 ? 'list' : r &lt; 7 ? 'dashboard' : r &lt; 9 ? 'home' : r &lt; 11 ? 'search' : 'write')
vars.put('term', ['report', 'meeting', 'task', 'zzz'][rnd.nextInt(4)])</stringProp>
</JSR223PreProcessor>
<hashTree></hashTree>
<UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think time (default 1-3 s)" enabled="true">
  <stringProp name="ConstantTimer.delay">${__P(think_min,1000)}</stringProp>
  <stringProp name="RandomTimer.range">${__P(think_range,2000)}</stringProp>
</UniformRandomTimer>
<hashTree></hashTree>
</hashTree>
<SwitchController guiclass="SwitchControllerGui" testclass="SwitchController" testname="Run chosen action" enabled="true">
